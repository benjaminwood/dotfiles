{{- $environment := "personal" -}}
{{- if or (stat "/.dockerenv") (stat "/run/.containerenv") -}}
{{-   $environment = "docker" -}}
{{- end -}}
{{- $macSourceDir := joinPath .chezmoi.homeDir "projects/benjaminwood/dotfiles" -}}

{{- if and (eq .chezmoi.os "darwin") (stat $macSourceDir) }}
sourceDir: {{ $macSourceDir | quote }}
{{- end }}

data:
  environment: {{ $environment | quote }}
  is_docker: {{ eq $environment "docker" }}
  is_macos: {{ eq .chezmoi.os "darwin" }}
  is_linux_desktop: {{ and (eq .chezmoi.os "linux") (ne $environment "docker") }}
  # NixOS: packages come from the system config, chezmoi only places files.
  is_nixos: {{ if stat "/etc/NIXOS" }}true{{ else }}false{{ end }}
  name: "Benjamin Wood"
  email: "benjaminwood@gmail.com"
