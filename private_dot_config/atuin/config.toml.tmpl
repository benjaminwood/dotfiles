{{- if .is_docker }}
{{- $atuinHost := env "ATUIN_SYNC_HOST" -}}
{{- if not $atuinHost -}}
{{-   $atuinHost = (output "sh" "-c" "nc -z host.docker.internal 8888 2>/dev/null && echo -n host.docker.internal || ip route | awk 'NR==1 {print $3}' | tr -d '\\n'") -}}
{{- end -}}
{{- if not $atuinHost -}}
{{-   $atuinHost = "host.docker.internal" -}}
{{- end }}
sync_address = "http://{{ $atuinHost }}:8888"
{{- else if .is_nixos }}
{{- /* eldar-os runs the server; its VM (hostname eldar) reaches it at the host's VM address */}}
sync_address = "http://{{ if eq .chezmoi.hostname "eldar" }}10.42.0.1{{ else }}127.0.0.1{{ end }}:8888"
{{- end }}
{{- if .is_macos }}
{{- if .tailnet }}
sync_address = "https://atuin.{{ .tailnet }}"
{{- else }}
sync_address = "http://desktop:8888"
{{- end }}
enter_accept = true

[sync]
records = true
{{- else }}
filter_mode = "host"
{{- end }}
